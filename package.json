{
  "name": "@local/dsh-read-image-compress",
  "version": "0.3.0",
  "private": true,
  "description": "Compress read_image results before they enter the session: downscale pixels, choose JPEG/WebP/PNG, tune quality from the Plugins page, and print an original/compressed/ratio footer under the image.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
